# Copier ce fichier vers .env.local puis renseigner la clé.
# Clé gratuite (100 requêtes/jour) : https://dashboard.api-football.com
API_FOOTBALL_KEY=

# Optionnel — valeurs par défaut :
# API_FOOTBALL_BASE=https://v3.football.api-sports.io
# API_FOOTBALL_LEAGUE_ID=61        # Ligue 1
# API_FOOTBALL_SEASON=2026         # saison 2026-27 (déduite de la date sinon)

# Authentification Clerk (https://dashboard.clerk.com — gratuit jusqu'à
# 10 000 utilisateurs actifs). Sans ces clés : mode mono-utilisateur local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Base Postgres (Neon : https://neon.tech, tier gratuit). Sans DATABASE_URL,
# la persistance se fait dans des fichiers locaux .store/ (dev).
# Exemple Neon : postgres://user:mdp@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secret du cron de clôture (/api/cron). Sur Vercel, définir la variable
# CRON_SECRET : Vercel Cron l'envoie automatiquement en Authorization Bearer.
CRON_SECRET=
