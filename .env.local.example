# Copier ce fichier vers .env.local puis renseigner la clé.
# Clé gratuite (100 requêtes/jour) : https://dashboard.api-football.com
API_FOOTBALL_KEY=

# Optionnel — valeurs par défaut :
# API_FOOTBALL_BASE=https://v3.football.api-sports.io
# API_FOOTBALL_LEAGUE_ID=61        # Ligue 1
# API_FOOTBALL_SEASON=2026         # saison 2026-27 (déduite de la date sinon)
